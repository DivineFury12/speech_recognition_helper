# Скопируйте в backend/.env и укажите ключ авторизации из кабинета GigaChat API.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
EMBEDDING_MODEL=e5
# Локальная БД Compose. Для внешней БД задайте DATABASE_URL.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant
# Путь к доверенному CA bundle внутри контейнера, если он требуется.
GIGACHAT_CA_BUNDLE=
# Голос: false — только текст, без распознавания речи и озвучки.
VOICE_ENABLED=true
# Код доступа к стенду; пусто — без кода.
ACCESS_CODE=
# Секрет для подписи кук; пусто — создаётся сам в DATA_DIR.
SESSION_SECRET=
# true, если сайт открыт по HTTPS.
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=30
