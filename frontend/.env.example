# Адрес backend. Пусто — запросы идут через прокси Vite (рекомендуется для dev, CORS не нужен).
# Задайте полный адрес (http://host:8000), если фронт раздаётся отдельно от backend.
VITE_API_URL=
# Куда dev-сервер проксирует /v1 и /health, когда VITE_API_URL пуст
API_PROXY_TARGET=http://127.0.0.1:8000
# true — работать на моках MSW без backend
VITE_USE_MOCKS=true
